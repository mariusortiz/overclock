extends NavigationRegion3D
## Arena root. The navigation mesh is baked at startup from the collision
## shapes, because the arena is generated by tools/make_arena.py and never
## baked in the editor.


func _ready() -> void:
	# CSG shapes build their collision during the first frames.
	await get_tree().physics_frame
	await get_tree().physics_frame
	bake_navigation_mesh(false)
