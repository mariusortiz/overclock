class_name Arena
extends NavigationRegion3D
## Root of an arena scene (generated by tools/make_arena.py). The navigation
## mesh is baked at startup from the collision shapes, because the scenes are
## never baked in the editor.

@export var display_name := ""
## Model of the regular enemies met in this arena.
@export var enemy_model: PackedScene
## What they fight with: see Enemy.weapon_id.
@export var enemy_weapon := "blaster"
## Music played in this arena (a Music.Track value).
@export var music_track := 0
## Its enemies are taken by the Virus (a green glow, see Enemy.corrupted).
@export var corrupted := false
## A glow over its enemies, of this color (none when transparent): the crystal
## planet's sentinels, for one.
@export var enemy_glow := Color(0, 0, 0, 0)

## The navigation mesh is baked and in use.
signal navigation_ready
const NAVIGATION_ATTEMPTS := 5
var is_navigation_ready := false


func _ready() -> void:
	add_to_group("arena")
	# CSG shapes build their collision during the first frames.
	await get_tree().physics_frame
	await get_tree().physics_frame
	bake_navigation_mesh(false)
	await get_tree().physics_frame
	# The navigation map can keep the empty region it had before the bake (it
	# happens to the first arena of a run): switching the region off and on
	# makes it take the baked mesh.
	for attempt in NAVIGATION_ATTEMPTS:
		if _has_path():
			break
		enabled = false
		for i in 3:
			await get_tree().physics_frame
		enabled = true
		for i in 3:
			await get_tree().physics_frame
	is_navigation_ready = true
	navigation_ready.emit()


func _has_path() -> bool:
	return not NavigationServer3D.map_get_path(get_navigation_map(), player_spawn_position(),
			boss_spawn_position(), true).is_empty()


func player_spawn_position() -> Vector3:
	return $PlayerSpawn.global_position


## Where a wave's boss appears: on the floor, in the open.
func boss_spawn_position() -> Vector3:
	return $BossSpawn.global_position


## Low quality turns off shadows and glow.
func apply_quality(high: bool) -> void:
	($Sun as DirectionalLight3D).shadow_enabled = high
	($WorldEnvironment as WorldEnvironment).environment.glow_enabled = high
